# Copie este arquivo para .env e preencha os valores
# Nunca suba o .env para o GitHub!

SECRET_KEY=troque-por-uma-chave-secreta-longa
DEBUG=False
ALLOWED_HOSTS=seu-app.azurewebsites.net,localhost

# PostgreSQL no Azure
DATABASE_URL=postgres://usuario:senha@host.postgres.database.azure.com:5432/nome_do_banco?sslmode=require

# GitHub OAuth (obtido em github.com/settings/developers)
GITHUB_CLIENT_ID=seu_client_id
GITHUB_CLIENT_SECRET=seu_client_secret
